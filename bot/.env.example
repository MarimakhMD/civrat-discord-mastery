# ═══════════════════════════════════════════════════
# CIVRAT DISCORD BOT - Configuration
# ═══════════════════════════════════════════════════

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID
CLIENT_ID=1478877109538652371

# Optional: set once to the Discord test guild ID when cleaning historical
# guild-scoped commands that duplicate the global command list.
LEGACY_GUILD_ID=

# MongoDB Connection URI (for analytics, XP, runtime state)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=CIVRAT
MONGO_DB_NAME=civrat_bot

# Supabase Configuration (single source of truth for guild config)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Configuration
API_PORT=20488
API_SECRET=your-super-secret-jwt-key-change-this-32chars-min
DASHBOARD_URL=http://localhost:3000

# Discord OAuth2 (for dashboard login)
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:20488/api/auth/callback
