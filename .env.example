# Public dashboard configuration. Never add secrets to VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_DISCORD_CLIENT_ID=your-discord-client-id

# Required in production: public HTTPS base URL of the authenticated bot API.
VITE_BOT_API_URL=https://bot-api.example.com

# Optional temporary diagnostic switch. Logs only token presence/length, never token values.
VITE_AUTH_DEBUG=false
